# infra/self-host/.env.example — шаблон переменных окружения для docker-compose.yml
#
# Как пользоваться:
#   cp .env.example .env
#   $EDITOR .env        # заполните значения ниже
#   docker compose -f infra/self-host/docker-compose.yml up -d
#
# docker compose автоматически подхватывает .env из каталога с compose-файлом
# (infra/self-host/.env). Файл .env уже исключён из git (.gitignore) —
# секреты не попадут в репозиторий.
#
# Генерация стойких секретов:
#   openssl rand -base64 32
#
# Без заполненного .env `docker compose up` завершится ошибкой с понятным
# сообщением — это осознанный дизайн: сервисы не должны стартовать
# с паролями по умолчанию.

# ── Glitchtip ─────────────────────────────────────────────────────────
# Пароль БД Postgres для Glitchtip. Используется ОДНОВРЕМЕННО в двух
# сервисах: glitchtip (DATABASE_URL) и glitchtip-db (POSTGRES_PASSWORD) —
# значения обязаны совпадать, иначе контейнеры не увидят друг друга.
GLITCHTIP_DB_PASSWORD=

# Секретный ключ Django для Glitchtip (подпись сессий, CSRF, токены).
# Требование: случайная строка >= 32 символов, никак не «change-me».
# Генерация: openssl rand -base64 32
GLITCHTIP_SECRET_KEY=
