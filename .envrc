# .envrc — direnv integration для Polymath OS
#
# Активируется автоматически при `cd` в репо (если выполнено `direnv allow`).
# - `use flake` запускает `nix develop` через nix-direnv (с кэшированием).
# - .env.local (gitignored) — персональные overrides: DATABASE_URL на remote
#   Postgres, OTEL endpoint на remote collector, API-ключи для dev.
#
# См. flake.nix, .gitignore (`.env.local` исключён), docs/05-devex-ci.md.

# Точка входа: nix flake dev-shell (см. flake.nix).
# nix-direnv кэширует сборку, иначе каждый `cd` пересобирал бы окружение.
use flake

# Персональные overrides поверх flake defaults.
# .env.local gitignored (см. .gitignore: `.env.local`). Можно держать там
# специфичные для машины значения: DATABASE_URL на remote Postgres,
# OTEL_EXPORTER_OTLP_ENDPOINT на remote collector, dev-API-ключи.
# Никогда не коммитить .env.local — Принцип 6 (automation over discipline)
# требует, чтобы секреты были в SOPS+age (см. ADR-0002 Tier 1), не в env-files.
if [ -f ".env.local" ]; then
  source_env .env.local
fi

# Подсказка для разработчика при первом `direnv allow`.
if [ -z "${POLYMATH_DIRENV_LOADED:-}" ]; then
  export POLYMATH_DIRENV_LOADED=1
  echo "  [direnv] Polymath OS dev shell loaded. Verify: make verify"
fi
