{
  "name": "polymath-os-garden",
  "version": "0.1.0",
  "private": true,
  "description": "Quartz v4 digital garden for Polymath OS \u2014 public export of vault/60-permanent/ (default-deny per ADR-0009)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "quartz": "./quartz/bootstrap-cli.mjs",
    "build": "npx quartz build -d content -o public",
    "serve": "npx quartz build -d content -o public --serve",
    "clean": "rm -rf public .quartz-cache",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "cd ../.. && biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json || true",
    "test": "python3 scripts/filter_vault.py --help >/dev/null && echo \"filter_vault.py CLI sanity OK\""
  },
  "dependencies": {
    "@jackyzha0/quartz": "github:jackyzha0/quartz#v4"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
