{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polymath-os.local/schemas/agent-card.json",
  "title": "Polymath-OS Agent Card (per ADR-0023)",
  "description": "A2A-compatible Agent Card with Polymath-OS decree_scope extension. Located at .well-known/agent.json for HTTP-discoverable agents, or embedded in AgentCard class for in-process agents.",
  "type": "object",
  "required": ["id", "name", "description", "version", "capabilities", "decree_scope"],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional reference to this schema"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.\\-]{0,63}$",
      "description": "Agent identifier — lowercase letters, digits, dots, hyphens. Max 64 chars. Examples: singulyar-eir.local, polymath-os.browser, cell65-host.llm",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "description": "Human-readable agent name",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "What this agent does",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "description": "Agent version (semver-ish, e.g. 'v0.6')",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "description": "A2A + MCP protocol versions, e.g. 'a2a/1.0 + mcp/1.0'",
      "default": "a2a/1.0 + mcp/1.0"
    },
    "capabilities": {
      "type": "array",
      "description": "Operations this agent can perform (e.g. 'intent.execute', 'llm.generate')",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "decree_scope": {
      "type": "string",
      "description": "Polymath-OS extension: which decrees apply to this agent. 'all' = all decrees. Otherwise, only decrees with matching scope are enforced.",
      "minLength": 1,
      "default": "all"
    },
    "endpoints": {
      "type": "array",
      "description": "Transport endpoints where this agent is reachable",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["http", "https", "websocket", "webrtc", "stdio", "in-process"]
          },
          "url": {
            "type": "string",
            "default": ""
          },
          "metadata": {
            "type": "object",
            "additionalProperties": true,
            "default": {}
          }
        }
      },
      "default": []
    },
    "auth": {
      "type": "object",
      "description": "Authentication requirements",
      "properties": {
        "type": {
          "type": "string",
          "description": "Auth type — 'decree' is the Polymath-OS default"
        },
        "description": {
          "type": "string"
        }
      },
      "default": {"type": "decree"}
    },
    "maintainer": {
      "type": "string",
      "default": "polymath-os"
    },
    "license": {
      "type": "string",
      "default": "MIT"
    },
    "homepage": {
      "type": "string",
      "default": "https://github.com/rtynbirf/polymath-os"
    },
    "tags": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
