{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "description": "Polymath OS — Renovate config. Schedule weekly, auto-merge minor devDeps after CI green, group eslint + typescript + github-actions. Alternative to dependabot (use one of them — not both — by enabling/disabling Renovate App on https://github.com/apps/renovate).",
  "schedule": ["after 6am on monday"],
  "timezone": "UTC",
  "labels": ["type:chore", "dependencies"],
  "rangeStrategy": "replace",
  "commitMessagePrefix": "chore(deps):",
  "commitMessageTopic": "{{depName}}",
  "prHeader": "Renovate — automated dependency update",
  "prFooter": "This PR was generated by Renovate. `make verify` must stay green before merge.",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "branchPrefix": "renovate/",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate dashboard — Polymath OS",
  "packageRules": [
    {
      "description": "Auto-merge minor/patch devDeps after CI green (low-risk, high-volume).",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformCommit": true,
      "automergeStrategy": "squash"
    },
    {
      "description": "Patch-only auto-merge for prod deps (more conservative than devDeps).",
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformCommit": true,
      "automergeStrategy": "squash"
    },
    {
      "description": "Group eslint-related packages into one PR.",
      "matchPackagePatterns": ["^@eslint/", "^eslint", "^@typescript-eslint/"],
      "groupName": "eslint"
    },
    {
      "description": "Group typescript + @types/* into one PR.",
      "matchPackagePatterns": ["^typescript$", "^@types/"],
      "groupName": "typescript"
    },
    {
      "description": "Group all GitHub Actions updates into one PR.",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "commitMessagePrefix": "chore(ci-deps):"
    },
    {
      "description": "Intentionally pinned — never auto-bump (touches the build contract).",
      "matchPackageNames": ["pnpm", "turbo", "typescript", "@biomejs/biome"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "Security vulns — critical priority, separate PR, no auto-merge.",
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchDatasources": ["npm"],
      "vulnerabilityAlert": true,
      "labels": ["security", "priority:critical"],
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security", "priority:critical"],
    "schedule": ["at any time"]
  }
}
